# Copy to .env and fill in. Never commit .env.

# Claude API (or run `ant auth login` and leave this unset)
ANTHROPIC_API_KEY=

# Model used for scoring, drafting and fact-checking
CLAUDE_MODEL=claude-opus-5-5

# SQLite for local dev; switch to Postgres/Supabase in production, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/content_agent
DATABASE_URL=sqlite:///data/content_agent.db

# Telegram approval bot: create via @BotFather, then message the bot and
# get your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: path to an existing Chromium if you don't run `playwright install chromium`
CHROMIUM_PATH=

# Items scoring at or above this (0-10) are eligible for drafting
MIN_RELEVANCE_SCORE=7
